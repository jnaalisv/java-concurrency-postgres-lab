<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>lab</groupId>
        <artifactId>java-concurrency-postgres-lab</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>week01-katas</artifactId>
    <name>Week 1: bug katas</name>

    <!--
      Katas live in src/main/java/lab/week01/<kata>, one package each, with a README
      saying what the class is supposed to do. Their plain stress tests are in
      src/test/java and run with `mvn -pl week01-katas test`.

      jcstress tests live in src/main/java, as jcstress expects: its annotation
      processor generates the test harness at compile time, and the shaded
      jcstress.jar runs everything it finds. The setup is in the parent POM; this
      module opts in below. -Pjcstress skips the stress tests.

        mvn -pl week01-katas verify -Pjcstress                       run all tests
        mvn -pl week01-katas verify -Pjcstress -Djcstress.args="-t Counter -m quick"
        java -jar week01-katas/target/jcstress.jar -h                options
    -->

    <properties>
        <!-- Opt in to the parent's jcstress setup: build target/jcstress.jar, and run it under -Pjcstress. -->
        <jcstress.skip>false</jcstress.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjdk.jcstress</groupId>
            <artifactId>jcstress-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
